# Orientation 2026 — environment template
#
# Copy to `.env` at the REPO ROOT (not apps/web) and fill in. One canonical file:
# Next.js reads it because `next dev`/`next build` run with the root as cwd via
# the workspace scripts, and the Prisma CLI loads it from the cwd itself.
# `.env` is gitignored. Never commit real values.

# ─── Auth: Clerk (D13) ────────────────────────────────────────────────────────
# Dashboard → API keys. Use a *_test_* pair locally and a live pair in prod.
# Roles (student | volunteer | admin) live in the Clerk user's publicMetadata and
# are read through packages/core/auth, never inline.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Clerk → Webhooks → add endpoint `<site>/api/webhooks/clerk`, subscribe to
# user.created / user.updated / user.deleted, then paste the signing secret here.
# Leave blank locally: the route answers "not configured" instead of reporting a
# confusing signature failure, and users are synced lazily on first request anyway.
CLERK_WEBHOOK_SECRET=

# ─── Selfie storage: Cloudinary (D14, revised) ────────────────────────────────
# The primary credential set. Selfies upload as `type: authenticated` — no public
# URL exists; volunteers and admins fetch short-lived signed URLs.
# Secondary credential sets (used when this account fills up) are added by an
# admin in the UI and stored encrypted in CloudinaryConfig, not here.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Database ────────────────────────────────────────────────────────────────
# Locally this points at the docker-compose Postgres. Railway injects its own
# DATABASE_URL; do not hardcode a production URL here.
#
# Port 5433, not 5432: a machine with a native PostgreSQL install already holds
# 5432, and on Windows the container's bind succeeds anyway — so compose reports
# `healthy` while Prisma talks to the other server and fails authentication.
# Use 127.0.0.1 rather than `localhost`, which resolves to ::1 first on Windows.
POSTGRES_USER=orientation
POSTGRES_PASSWORD=orientation_local_dev
POSTGRES_DB=orientation2026
POSTGRES_PORT=5433
DATABASE_URL=postgresql://orientation:orientation_local_dev@127.0.0.1:5433/orientation2026?schema=public&connection_limit=10

# ─── Redis ───────────────────────────────────────────────────────────────────
# Check-in locks, the offline manifest hash, and the SSE pub/sub bus (D10).
# 6380 for the same reason as 5433 above.
REDIS_PORT=6380
REDIS_URL=redis://127.0.0.1:6380

# ─── Crypto ──────────────────────────────────────────────────────────────────
# AES-256-GCM key protecting CloudinaryConfig.apiSecretCipher at rest. 32 bytes,
# base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating it makes every stored secondary Cloudinary secret unreadable, so a
# rotation means re-entering them in the admin UI.
SECRETS_KEY=

# ─── Pass signing: ECDSA P-256 (D5) ──────────────────────────────────────────
# PKCS#8 private / SPKI public, PEM, newlines as \n. Generate:
#   npm run keys:generate
# Only the public key is shipped to volunteer devices in the offline manifest.
# The private key must never leave the server.
PASS_PRIVATE_KEY=
PASS_PUBLIC_KEY=

# ─── Site ────────────────────────────────────────────────────────────────────
# Absolute origin used for share metadata and QR payload URLs. Set to the
# Railway domain (or custom domain) per environment.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Operations ──────────────────────────────────────────────────────────────
# One-time admin bootstrap. Set it, sign in, POST it to /api/admin/bootstrap once
# to grant yourself ADMIN, then DELETE THIS LINE and redeploy. It stops working by
# itself the moment an admin exists, but leaving it set is still a spare key under
# the mat. 24 characters minimum:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_BOOTSTRAP_KEY=

# Bearer token for the scheduled jobs at /api/cron/*, currently the DPDP selfie
# retention sweep. Point a Railway cron (or any pinger) at:
#   curl -X POST -H "Authorization: Bearer $CRON_SECRET" <site>/api/cron/retention
# Leave blank locally — the sweep is then reachable only from the admin console,
# which is deliberate: an unprotected endpoint that deletes selfies is worse than
# one that needs a button pressed. 24 characters minimum, generated as above.
CRON_SECRET=
