{
  "name": "orientation2026",
  "private": true,
  "version": "0.1.0",
  "description": "Amity University Patna — Orientation 2026 platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.11"
  },
  "prisma": {
    "seed": "node --env-file=.env --import tsx packages/db/prisma/seed.ts"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "npm run dev --workspace=@orientation/web",
    "build": "npm run build --workspace=@orientation/web",
    "start": "npm run start --workspace=@orientation/web",
    "lint": "npm run lint --workspace=@orientation/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "node --import tsx --test \"packages/*/src/**/*.test.ts\"",
    "keys:generate": "node --import tsx scripts/generate-keys.ts",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:nuke": "docker compose down -v",
    "db:generate": "prisma generate --schema packages/db/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema packages/db/prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema packages/db/prisma/schema.prisma",
    "db:reset": "prisma migrate reset --schema packages/db/prisma/schema.prisma",
    "db:studio": "prisma studio --schema packages/db/prisma/schema.prisma",
    "db:seed": "node --env-file=.env --import tsx packages/db/prisma/seed.ts",
    "postinstall": "npm run db:generate"
  },
  "dependencies": {
    "prisma": "6.19.3"
  },
  "devDependencies": {
    "prisma": "6.19.3",
    "tsx": "^4.23.13"
  }
}
