{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "buildCommand": "npm run build --workspace=@orientation/web",
    "watchPatterns": [
      "/apps/**",
      "/packages/**",
      "/package.json",
      "/package-lock.json",
      "/railway.json"
    ]
  },
  "deploy": {
    "startCommand": "npm run start --workspace=@orientation/web",
    "preDeployCommand": "npx prisma migrate deploy --schema packages/db/prisma/schema.prisma",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
